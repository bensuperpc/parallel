S3_ENDPOINT=http://seaweedfs:9000
S3_BUCKET=videos
S3_ACCESS_KEY=app
S3_SECRET_KEY=GENERATE:S3_SECRET_KEY

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASS=GENERATE:RABBITMQ_PASS

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASS=GENERATE:VALKEY_PASS

CELERY_EXCHANGE=video
CELERY_QUEUES=video.all
TEMP_DIR=/tmp
