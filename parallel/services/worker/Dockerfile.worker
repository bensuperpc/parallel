FROM bensuperpc/multimedia:1.0.0-archlinux-base

WORKDIR /app

# See api/Dockerfile.api for why this intentionally does not run `pacman -Syu`.
RUN pacman-key --init && \
    pacman -Sy --noconfirm python-pip && \
    pacman -Scc --noconfirm && \
    useradd --system --create-home --shell /usr/sbin/nologin appuser

COPY worker/requirements.txt .
RUN pip install --break-system-packages --no-cache-dir -r requirements.txt

COPY common/ common/
COPY tasks/ tasks/
COPY worker/start_worker.py worker/

RUN chown -R appuser:appuser /app
USER appuser

ENTRYPOINT ["python3", "worker/start_worker.py"]
