S3_ENDPOINT=http://seaweedfs:9000
S3_BUCKET=videos
S3_ACCESS_KEY=app
S3_SECRET_KEY=GENERATE:S3_SECRET_KEY

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASS=GENERATE:RABBITMQ_PASS
RABBITMQ_MGMT_URL=http://rabbitmq:15672

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASS=GENERATE:VALKEY_PASS

API_KEY=GENERATE:API_KEY
API_PORT=5500

API_RATE_LIMIT_DEFAULT=120/minute
API_RATE_LIMIT_UPLOAD=20/minute
MAX_UPLOAD_SIZE_BYTES=2147483648
ENABLE_DOCS=true

DEFAULT_CRF=16
